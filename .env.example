# Backend Railway (root proyek)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Frontend: salin ke frontend/.env.local saat development.
# Di Railway isi pada service frontend SEBELUM build, lalu rebuild.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Lokal kosong menggunakan proxy /api. Production isi URL backend HTTPS.
VITE_API_URL=
# Tidak memerlukan service_role atau secret key.
